# =============================================================================
# KhasCom — environment variables
#
# Copy to `.env` for local development. On Vercel, add each of these under
# Settings -> Environment Variables. Never commit a filled-in copy: `.gitignore`
# excludes `.env*`, and this example file is the only one that belongs in git.
# =============================================================================


# --- Site URL ---------------------------------------------------------------
# Canonical public URL, no trailing slash. Used for sitemap.xml, robots.txt and
# Open Graph share previews. Leave it unset and all three point at localhost,
# which stops the site being indexed correctly.
NEXT_PUBLIC_APP_URL="https://khascom.com"


# --- Database ---------------------------------------------------------------
# Postgres. The marketing pages render without it, but the blog, the admin
# portal and every inquiry form need it.
#
# On Supabase these are two different connection strings:
#   DATABASE_URL  port 6543, transaction-mode pooler — used by the running app
#   DIRECT_URL    port 5432, session-mode  — used by `prisma db push` / migrations
#
# Special characters in the password MUST be percent-encoded:
#   #  ->  %23      @  ->  %40      /  ->  %2F      :  ->  %3A
#   ?  ->  %3F      &  ->  %26      %  ->  %25      +  ->  %2B
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"


# --- Authentication ---------------------------------------------------------
# NextAuth refuses to run in production without a secret.
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Must match the deployed URL exactly, including https://
NEXTAUTH_URL="https://khascom.com"


# --- Admin portal login -----------------------------------------------------
# These two let an administrator sign in without any database row existing.
# If both are set, they are checked before the database is consulted.
ADMIN_USERNAME="admin@khascom.com"
ADMIN_PASSWORD="replace-me-with-a-strong-password"
